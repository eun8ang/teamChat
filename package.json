{
  "name": "team-chat-lab",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "test:ci": "vitest run",
    "check": "npm run lint && npm run typecheck && npm run test:ci && npm run build",
    "doctor": "node scripts/doctor.mjs",
    "workshop:conflict": "node scripts/conflict-lab.mjs",
    "present": "node scripts/present.mjs",
    "workshop:conflict:en": "node scripts/conflict-lab.mjs --en"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "vercel": "64.7.0",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
